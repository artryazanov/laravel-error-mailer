{
    "name": "artryazanov/laravel-error-mailer",
    "description": "A Laravel package for sending detailed error information via email.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Artem Ryazanov",
            "email": "artryazanov@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/mail": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.1.0 || ^11.0",
        "phpunit/phpunit": "^11.0|^12.0",
        "laravel/pint": "^1.29",
        "larastan/larastan": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Artryazanov\\ErrorMailer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Artryazanov\\ErrorMailer\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-text",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Artryazanov\\ErrorMailer\\ErrorMailerServiceProvider"
            ],
            "aliases": {
                "ErrorMailer": "Artryazanov\\ErrorMailer\\Facades\\ErrorMailer"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
